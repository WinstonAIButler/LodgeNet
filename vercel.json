{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/lodges/:slug",
      "destination": "/lodge"
    }
  ],
  "headers": [
    {
      "source": "/owner",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "functions": {
    "api/minutes.js": {
      "maxDuration": 120
    },
    "api/business-search.js": {
      "maxDuration": 300
    }
  }
}
