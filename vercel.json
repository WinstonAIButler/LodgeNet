{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "lodgenet.vercel.app"
        }
      ],
      "destination": "https://www.lodgenet.app/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/lodges/:slug",
      "destination": "/lodge"
    },
    {
      "source": "/site/:slug",
      "destination": "/lodge-site"
    },
    {
      "source": "/site/:slug/:rest*",
      "destination": "/lodge-site"
    },
    {
      "source": "/((?!api/|assets/|login|start|lodges/|owner|favicon|robots\\.txt|sitemap\\.xml).*)",
      "missing": [
        {
          "type": "host",
          "value": "(.*\\.)?lodgenet\\.app"
        },
        {
          "type": "host",
          "value": ".*\\.vercel\\.app"
        },
        {
          "type": "host",
          "value": "localhost"
        },
        {
          "type": "host",
          "value": "127\\.0\\.0\\.1"
        }
      ],
      "destination": "/lodge-site"
    }
  ],
  "headers": [
    {
      "source": "/owner",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "functions": {
    "api/minutes.js": {
      "maxDuration": 120
    },
    "api/business-search.js": {
      "maxDuration": 300
    },
    "api/jarvis.mjs": {
      "maxDuration": 120
    },
    "api/site-import.js": {
      "maxDuration": 300
    },
    "api/site-assist.js": {
      "maxDuration": 120
    },
    "api/domains.js": {
      "maxDuration": 120
    }
  },
  "crons": [
    {
      "path": "/api/domains?cron=1",
      "schedule": "0 9 * * *"
    }
  ]
}
